# API Configuration
# Replace these with your backend server's IP/URL

# Android Emulator (default) — uses 10.0.2.2 as gateway to host machine
REACT_APP_API_BASE_URL=http://10.0.2.2:3001/api
REACT_APP_WS_BASE_URL=http://10.0.2.2:3001

# iOS Simulator — localhost works directly
# REACT_APP_API_BASE_URL=http://localhost:3001/api
# REACT_APP_WS_BASE_URL=http://localhost:3001

# Physical Device on WiFi — use your PC's local IP
# Find your PC IP on Windows: run `ipconfig` in CMD, look for "IPv4 Address"
# Example: 192.168.1.100
# REACT_APP_API_BASE_URL=http://192.168.1.100:3001/api
# REACT_APP_WS_BASE_URL=http://192.168.1.100:3001
